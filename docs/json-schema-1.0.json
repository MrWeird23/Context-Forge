{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contextforge.dev/schemas/json-output-1.0.json",
  "title": "ContextForge JSON output 1.0",
  "description": "Stable envelope shared by successful command results and structured failures.",
  "type": "object",
  "required": [
    "schema_version",
    "command",
    "repository"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "error": {
      "$ref": "#/$defs/error"
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "report": {
      "type": "object",
      "properties": {
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$defs": {
    "claim": {
      "type": "object",
      "required": [
        "claim",
        "status",
        "confidence",
        "supporting_evidence",
        "conflicting_evidence",
        "unresolved_uncertainty"
      ],
      "properties": {
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["observed", "inferred"]
        },
        "confidence": {
          "enum": ["high", "medium", "low", "unknown"]
        },
        "supporting_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "conflicting_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "unresolved_uncertainty": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "error": {
      "type": "object",
      "required": [
        "code",
        "message",
        "details"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  }
}
